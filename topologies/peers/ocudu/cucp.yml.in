#
# OCUDU's CU-CP as kaluza-sim's peer on the dev PC (P2 Q4; ADR 0012): F1-C and E1
# on loopback, as our own split CU-CP would listen, N2 to the AMF given to
# tools/ocudu-peer.sh run (our scripted core by default). gNB ID 0x1A1 from our
# range; TAC 1, 001/01. The option names are OCUDU's (apps/units/o_cu_cp).
gnb_id: 417
gnb_id_bit_length: 22
ran_node_name: ocudu-cucp

cu_cp:
  amf:
    addrs: @AMF_ADDR@
    port: @AMF_PORT@
    bind_addrs: 127.0.0.5
    sctp_nodelay: true
    supported_tracking_areas:
      - tac: 1
        plmn_list:
          - plmn: "00101"
            tai_slice_support_list:
              - sst: 1
  inactivity_timer: 15
  security:
    nea_pref_list: @NEA_PREF@
    nia_pref_list: @NIA_PREF@
  e1ap:
    bind_addrs: 127.0.20.1
  f1ap:
    bind_addrs: 127.0.10.1

log:
  filename: @RUN_DIR@/ocudu-cucp.log
  all_level: warning

pcap:
  ngap_enable: true
  ngap_filename: @RUN_DIR@/ocudu-cucp-ngap.pcap
  f1ap_enable: true
  f1ap_filename: @RUN_DIR@/ocudu-cucp-f1ap.pcap
  e1ap_enable: true
  e1ap_filename: @RUN_DIR@/ocudu-cucp-e1ap.pcap
