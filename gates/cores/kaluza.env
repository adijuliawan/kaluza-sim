#
# kaluza-core in the lab (P1 N9): gates/run.sh on kaluza-uesim with KSIM_LAB=1,
# ksim-netd running, in a window agreed with the kaluza-core session.
CORE=kaluza
KSIM_TOPOLOGY=topologies/aio-lab.yaml
STUB=0
# The subscribed S-NSSAI (1/000001): a session asked for with SST 1 alone is
# sent back with 5GMM #90 (24.501 5.4.5.2.5 item 13; W1, 2026-10-15).
SLICE="--sst 1 --sd 000001"
