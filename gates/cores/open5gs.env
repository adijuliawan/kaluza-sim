#
# The Open5GS fork on the rig (ADR 0010): the 5GC NFs run from the rig's
# ~/kaluza-sim-rig/etc copy, started and stopped by tools/open5gs-rig.sh in a
# window agreed with the kaluza-core session (D5). gates/run.sh starts ksim only.
CORE=open5gs
KSIM_TOPOLOGY=topologies/aio-open5gs.yaml
STUB=0
# The provisioned S-NSSAI (1/000001), as on kaluza-core.
SLICE="--sst 1 --sd 000001"
