asn1c 18e56503 runtime: JER of an INTEGER past intmax_t (E1AP usage counts up
to 2^64-1). The encoder fell back to a colon-separated hex dump, which is not
JSON, and the decoder refused anything past LONG_MAX. A non-negative value
past intmax_t is now written and read as an unsigned decimal. JER serves
ksim-codec and the oracle harness only. Row KS-PLAT-D4.

--- a/INTEGER.c
+++ b/INTEGER.c
@@ -116,6 +116,14 @@
 	else
 		ret = asn_INTEGER2imax(st, &value);
 
+	/* A non-negative value past intmax_t (a 0..2^64-1 counter): still decimal */
+	if(ret != 0 && plainOrXER && !(specs && specs->field_unsigned)
+	   && !(specs && specs->strict_enumeration)) {
+		uintmax_t uvalue;
+		if(asn_INTEGER2umax(st, &uvalue) == 0)
+			return asn__format_to_callback(cb, app_key, "%" ASN_PRIuMAX, uvalue);
+	}
+
 	/* Simple case: the integer size is small */
 	if(ret == 0) {
 		const asn_INTEGER_enum_map_t *el;
