+        if(per_get_many_bits(pd, epres, 0, bmlength)) {
+            FREEMEM(epres);
             ASN__DECODE_STARVED;
+        }
 
         memset(&epmd, 0, sizeof(epmd));
         epmd.buffer = epres;
@@ -179,8 +181,10 @@
