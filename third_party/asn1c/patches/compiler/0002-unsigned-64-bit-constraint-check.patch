asn1c 18e56503 compiler: the constraint check for INTEGER (0..18446744073709551615)
read the value with asn_INTEGER2long, so any count above 2^63-1 failed the
check before encoding. A non-negative range up to 2^64-1 is now checked as an
unsigned long (64 bits on LP64, the only target). Applies after 0001; goes
with runtime patch 0003. Row KS-PLAT-D4.

diff --git a/libasn1compiler/asn1c_constraint.c b/libasn1compiler/asn1c_constraint.c
index 893d9ce7..a78d4b08 100644
--- a/libasn1compiler/asn1c_constraint.c
+++ b/libasn1compiler/asn1c_constraint.c
@@ -762,6 +762,15 @@ native_long_sign(arg_t *arg, asn1cnst_range_t *r) {
 			return 0;
 		else
 			return 1;
+	} else if(r->left.type == ARE_VALUE
+	&& r->left.value >= 0
+	&& r->right.type == ARE_VALUE
+	&& r->right.value > (asn1c_integer_t)(9223372036854775807LL)
+	&& r->right.value <= (asn1c_integer_t)(18446744073709551615ULL)
+	&& sizeof(unsigned long) == 8) {
+		/* past LONG_MAX, up to 2^64-1 (0..18446744073709551615): checked as an
+		 * unsigned long on LP64; narrower ranges keep the signed long path */
+		return 1;
 	} else {
 		return -1;
 	}
